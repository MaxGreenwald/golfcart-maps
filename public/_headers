# Cloudflare Pages headers (ignored by GitHub Pages)
# Town videos (content/videos.json) use a https://www.youtube-nocookie.com frame and an
# https://i.ytimg.com thumbnail. No Content-Security-Policy is set, so those hosts are
# allowed. If a CSP is added, keep both. tests/test_town_videos.py checks this.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/app.js
  Cache-Control: public, max-age=0, must-revalidate
/range.js
  Cache-Control: public, max-age=0, must-revalidate
/regions.js
  Cache-Control: public, max-age=0, must-revalidate
/offline.js
  Cache-Control: public, max-age=0, must-revalidate

# Native WebView (capacitor://localhost) reads this JSON. Same-origin website fetches ignore CORS.
# App Store 2.5.2: these are data files. The app does not download scripts from here.
# Revalidate every time (cheap 304 via ETag) so /p/<slug>, /partner and /map never show day-old roads (Max, Oct 29 2026).
# /map offline use still works: the service worker keeps its own copy.
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/icon-*
  Cache-Control: public, max-age=604800
/og*.png
  Cache-Control: public, max-age=604800
/pay.js
  Cache-Control: public, max-age=0, must-revalidate

/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
