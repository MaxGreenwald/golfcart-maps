# Cloudflare Pages headers (ignored by GitHub Pages)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/app.js
  Cache-Control: public, max-age=0, must-revalidate
/range.js
  Cache-Control: public, max-age=0, must-revalidate
/regions.js
  Cache-Control: public, max-age=0, must-revalidate

# Native WebView (capacitor://localhost) reads this JSON. Same-origin website fetches ignore CORS.
# App Store 2.5.2: these are data files. The app does not download scripts from here.
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/icon-*
  Cache-Control: public, max-age=604800
/og*.png
  Cache-Control: public, max-age=604800
/pay.js
  Cache-Control: public, max-age=0, must-revalidate
